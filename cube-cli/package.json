{
  "name": "@cube/cli",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cube": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "predev": "pnpm --filter @cube/agent --filter @cube/tui run build",
    "dev": "tsx src/index.ts",
    "build": "tsc --build",
    "clean": "node ../scripts/clean-package.mjs",
    "test": "tsx --test --test-isolation=none tests/**/*.test.ts"
  },
  "dependencies": {
    "@cube/agent": "workspace:*",
    "@cube/tui": "workspace:*",
    "@cube/workspace": "workspace:*",
    "chalk": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "22.13.1"
  }
}
