# Host mode can use http://host.docker.internal:11434 if Ollama runs outside Docker.
OLLAMA_BASE_URL=http://ollama:11434

#Tavily API Key
TAVILY_API_KEY=

#Gateway
TELEGRAM_BOT_TOKEN=
LANGGRAPH_API_URL=http://localhost:8123
LANGGRAPH_ASSISTANT_ID=main_agent
