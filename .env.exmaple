#Langsmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-agent-dev
LANGCHAIN_VERBOSE=true

#MongoDB
MONGODB_URI=
MONGODB_DB=

#LLM API Key
GEMINI_API_KEY=
