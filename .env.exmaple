#Langsmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-agent-dev
LANGCHAIN_VERBOSE=true

#MongoDB
MONGODB_URI=
MONGODB_DB=

# LangGraph Agent Server checkpointer
# Required when langgraph.json uses { "checkpointer": { "backend": "mongo" } }.
# URI must include the database name, for example /langgraph.
LS_MONGODB_URI=

#LLM API Key
GEMINI_API_KEY=
# Docker mode with docker-compose.local.yml uses http://ollama:11434.
# Host mode can use http://host.docker.internal:11434 if Ollama runs outside Docker.
OLLAMA_BASE_URL=http://ollama:11434

#Tavily API Key
TAVILY_API_KEY=
