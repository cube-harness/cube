{
  "name": "@cube/tui",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cube": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "predev": "pnpm --filter @cube/workspace --filter @cube/agent --filter @cube/runtime run build",
    "dev": "tsx src/bin.ts",
    "build": "tsc --build",
    "test": "tsx --test --test-isolation=none tests/**/*.test.ts",
    "clean": "node ../scripts/clean-package.mjs"
  },
  "dependencies": {
    "@cube/runtime": "workspace:*",
    "@earendil-works/pi-tui": "0.83.0",
    "chalk": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
