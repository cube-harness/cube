{
  "name": "cube-monorepo",
  "version": "0.1.6",
  "private": true,
  "description": "Cube CLI - Production-Grade Interactive Coding Agent CLI",
  "type": "module",
  "scripts": {
    "package:app": "node scripts/build-binary.mjs",
    "package:windows": "node scripts/build-binary.mjs",
    "bench:internal": "tsx benchmarks/internal-latency.ts",
    "bench:package": "node benchmarks/package-benchmark.mjs",
    "bench:test": "node --test benchmarks/benchmark.test.mjs",
    "dev": "pnpm --filter @cube/tui dev",
    "dev:factory": "pnpm --filter @cube/factory-ui dev",
    "studio": "pnpm --filter @cube/agent studio",
    "build": "pnpm --recursive run build",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "esbuild": "^0.28.2",
    "mastra": "^1.27.2",
    "tsx": "4.19.3",
    "turbo": "2.10.8",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
