    "jest": "30.2.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@langchain/core": "1.2.2",
    "@langchain/google": "0.2.1",
    "@langchain/google-genai": "2.2.0",
    "@langchain/langgraph": "1.4.7",
    "@langchain/langgraph-sdk": "1.9.25",
    "@langchain/ollama": "1.3.0",
    "@langchain/tavily": "1.2.0",
    "dotenv": "17.4.2",
